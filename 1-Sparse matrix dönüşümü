#include <stdio.h>

int main() {
    int matrix[10][10];
    int sparse[50][3];
    int rows, column;
    int i, j, k = 1;

    printf("Enter number of rows and columns: ");
    scanf("%d %d", &rows, &column);

    printf("Enter matrix elements:");
    for (i = 0; i < rows; i++) {
        for (j = 0; j < column; j++) {
            scanf("%d", &matrix[i][j]);
        }
    }

    
    sparse[0][0] = rows;
    sparse[0][1] = column;
    sparse[0][2] = 0;

   
    for (i = 0; i < rows; i++) {
        for (j = 0; j < column; j++) {
            if (matrix[i][j] != 0) {
                sparse[k][0] = i;
                sparse[k][1] = j;
                sparse[k][2] = matrix[i][j];
                k++;
                sparse[0][2]++;
            }
        }
    }

    
    printf("Sparse Matrix (Triplet Form):\n");
    printf("Row column Value\n");
    for (i = 0; i <= sparse[0][2]; i++) {
        printf("%d   %d   %d\n",
               sparse[i][0],
               sparse[i][1],
               sparse[i][2]);
    }

    return 0;
}
