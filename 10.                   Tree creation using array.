#include <stdio.h>

#define MAX 100

int tree[MAX];
int n;


void inorder(int i) {
    if (i >= n || tree[i] == -1)
        return;

    inorder(2*i + 1);
    printf("%d ", tree[i]);
    inorder(2*i + 2);
}


void preorder(int i) {
    if (i >= n || tree[i] == -1)
        return;

    printf("%d ", tree[i]);
    preorder(2*i + 1);
    preorder(2*i + 2);
}


void postorder(int i) {
    if (i >= n || tree[i] == -1)
        return;

    postorder(2*i + 1);
    postorder(2*i + 2);
    printf("%d ", tree[i]);
}

int main() {
    int i;

    printf("Enter number of nodes: ");
    scanf("%d", &n);

    printf("Enter tree elements (-1 for empty node):");
    for (i = 0; i < n; i++) {
        scanf("%d", &tree[i]);
    }

    printf("Inorder Traversal: ");
    inorder(0);

    printf("Preorder Traversal: ");
    preorder(0);

    printf("Postorder Traversal: ");
    postorder(0);

    return 0;
}
